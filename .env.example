# PostgreSQL database (Neon recommended on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/metu?sslmode=require"

# Auth.js / NextAuth
NEXTAUTH_SECRET="generate-a-unique-32-byte-secret"
NEXTAUTH_URL="https://your-domain.example"

# Stripe (use test keys until launch)
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"

# Comma-separated email addresses allowed to access the admin area.
ADMIN_EMAILS="owner@example.com"

# Optional canonical public URL
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Product listings remain hidden until you have approved seller partners.
MARKETPLACE_PRODUCTS_ENABLED=false
